    # Use symlog to properly display negative values without absolute value workarounds
    ax.set_yscale('symlog', linthresh=1e-4, linscale=1)
    
    yticks = [-1e-2, -1e-3, -1e-4, 0, 1e-4, 1e-3, 1e-2]
